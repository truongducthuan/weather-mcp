{
  "name": "example-oai-app",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fractal-mcp/sdk.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "npx @fractal-mcp/cli bundle --entrypoint=./ui/main.tsx --out=./ui/bundle --root-only --inline-js --inline-css",
    "build:server": "tsc",
    "start": "tsx watch server/index.ts"
  },
  "dependencies": {
    "@fractal-mcp/bundle": "latest",
    "@fractal-mcp/oai-hooks": "latest",
    "@fractal-mcp/oai-server": "latest",
    "@types/node-fetch": "^2.6.13",
    "express": "^5.1.0",
    "node-fetch": "^2.7.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
